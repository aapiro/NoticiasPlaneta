# Copia a .env y rellena. Nunca subas .env al repositorio.
DB_PASSWORD=cambia-esta-clave
AGENT_API_KEY=genera-una-clave-larga-y-aleatoria
AGENT_ID=newsroom-agent
RP_ID=noticiasplaneta.com
RP_ORIGIN=https://noticiasplaneta.com

# Langfuse (observabilidad LLM). Sin claves, el tracing queda desactivado (no-op).
# Crea un proyecto en https://cloud.langfuse.com y copia las claves desde
# Settings -> API Keys. Nunca subas este .env al repositorio.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_ENABLED=true
LANGFUSE_SAMPLE_RATE=1.0
LANGFUSE_ENVIRONMENT=development
